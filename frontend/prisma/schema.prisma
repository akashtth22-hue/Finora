generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String

  image       String?
  phone       String?
  isVerified  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
